# First Twenty staging: look for a new commit on main every 5 minutes.
# Check it: systemctl list-timers first-twenty-autoupdate-staging.timer

[Unit]
Description=First Twenty staging: check main every 5 minutes

[Timer]
OnCalendar=*:0/5
RandomizedDelaySec=60
AccuracySec=10s

[Install]
WantedBy=timers.target
