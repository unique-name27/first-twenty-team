# First Twenty live: look for a new release every 5 minutes.
# Check it: systemctl list-timers first-twenty-autoupdate-live.timer

[Unit]
Description=First Twenty live: check for a new release every 5 minutes

[Timer]
OnCalendar=*:0/5
RandomizedDelaySec=60
AccuracySec=10s

[Install]
WantedBy=timers.target
