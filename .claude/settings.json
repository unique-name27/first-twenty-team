{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run verify)",
      "Bash(npm run check)",
      "Bash(npm run typecheck)",
      "Bash(npm test:*)",
      "Bash(npm run test:unit:*)",
      "Bash(npm run test:server:*)",
      "Bash(npm run test:e2e:*)",
      "Bash(npm run test:deploy:*)",
      "Bash(npm run test:changed:*)",
      "Bash(npm run test:watch:*)",
      "Bash(npm run stack:*)",
      "Bash(npm run sql:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin master:*)"
    ]
  }
}
